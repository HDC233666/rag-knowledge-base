# ===== 复制本文件为 .env，填入你自己的 Key =====
# .env 已被 .gitignore 忽略，不会上传到 GitHub

# DeepSeek API Key（也可用同名 Windows 环境变量，二选一即可）
DEEPSEEK_API_KEY=

# DeepSeek 接口地址（OpenAI 兼容格式），一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型：deepseek-chat（默认对话）/ deepseek-reasoner（推理）/ deepseek-v4-pro 等
DEEPSEEK_MODEL=deepseek-chat

# ===== 检索参数 =====
# 每次喂给模型的片段数
RAG_TOP_K=4
# 每个片段的目标字数
RAG_CHUNK_SIZE=600
# 相邻片段重叠字数（防止一句话被切断）
RAG_CHUNK_OVERLAP=80
# 回答温度：0 最稳定，1 最发散
RAG_TEMPERATURE=0.2

# ===== 检索增强（v2）=====
# 向量模型：默认 bge-small-zh（中文、512 维、CPU 可跑）
# 换成别的模型后旧向量会自动重建；RAG_EMBED_BACKEND=hash 可强制用零依赖的哈希兜底（CI 用）
RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# BM25 与向量各召回多少个候选，再交给 RRF 融合
RAG_CANDIDATE_K=12
# RRF 融合常数（论文经验值 60）
RAG_RRF_K=60
# 查询改写（多查询召回）：1 开 / 0 关（关掉省一次大模型调用）
RAG_ENABLE_REWRITE=1
# LLM 重排：1 开 / 0 关（关掉省一次大模型调用）
RAG_ENABLE_RERANK=1
# 重排后端：llm（默认，调大模型打分）/ cross（本地 bge-reranker，首次需下载模型）
RAG_RERANK_BACKEND=llm
# cross 后端用的模型
RAG_CROSS_ENCODER_MODEL=BAAI/bge-reranker-base

# ===== 缓存（v2）=====
# 改写/重排结果的本地缓存：1 开 / 0 关（关掉不影响功能，只影响延迟）
RAG_ENABLE_CACHE=1
# 缓存过期时间（秒），默认 1 小时
RAG_CACHE_TTL=3600

# ===== 限流（v3）=====
# 每个 IP 每分钟最多问几次，0 = 关闭；超限返回 429
RAG_RATE_LIMIT=60

# ===== 向量索引（v4）=====
# auto = 装了 faiss 就用 FAISS HNSW，否则 numpy 精确检索；也可强制 numpy / faiss
RAG_VECTOR_BACKEND=auto
# HNSW 连边数 M：越大越准、越占内存（一般 16~64）
RAG_FAISS_M=32
# 查询候选数 efSearch：越大越准、越慢
RAG_FAISS_EF_SEARCH=64

# ===== 存储后端（可选）=====
# 留空 = 用本地 data/db.json（默认，零配置，开箱即用）
# 填了 = 用 MySQL 存文档和切分块；连不上会自动降级回 JSON，不会让服务挂掉
RAG_DB_HOST=
RAG_DB_PORT=3306
RAG_DB_USER=
RAG_DB_PASSWORD=
RAG_DB_NAME=rag_kb

# 模型缓存目录（容器里建议挂载卷，避免每次重启重新下载）
RAG_EMBED_CACHE=
